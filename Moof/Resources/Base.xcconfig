// Configuration settings file format documentation can be found at:
// https://developer.apple.com/documentation/xcode/adding-a-build-configuration-file-to-your-project

// CFBundleVersion is not set here: the "Build Number" phase stamps the commit
// count of HEAD into the built Info.plist.
MARKETING_VERSION = 1.0

// YES builds for the Mac App Store: sandboxed, and the Swift condition APP_STORE swaps
// the privileged CLI install for a command the user runs.
MOOF_APP_STORE = NO
MOOF_APP_STORE_CONDITION_YES = APP_STORE
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(MOOF_APP_STORE_CONDITION_$(MOOF_APP_STORE))
